<IfModule mod_authz_core.c>
  <FilesMatch "^(config\.php|config\.example\.php|lib\.php|test\.php)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule mod_access_compat.c>
  <FilesMatch "^(config\.php|config\.example\.php|lib\.php|test\.php)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^data/ - [F]
</IfModule>
